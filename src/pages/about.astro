---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
---

<BaseLayout title="About">
  <MainCard
    title="About"
    description="Cherish life, Enjoy every moments <3"
    image="/home.webp"
    alt="about image"
    infoIcon="lucide:user"
  >
    <div class="mb-6 space-y-6">

      <!-- Profile Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h1
            class="mb-4 text-4xl font-bold from-primary to-secondary hover:text-primary transition-colors duration-300 cursor-default"
          >
            Hwangstice
          </h1>

          <p class="mb-4 text-xl text-base-content/80">
            We Only Live Once
          </p>

          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://github.com/hwangstice"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:github" class="h-4 w-4" />
              <span>GitHub</span>
            </a>

            <a
              href="mailto:hwangstice@gmail.com"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:mail" class="h-4 w-4" />
              <span>Email</span>
            </a>
          </div>

          <div class="flex-1 text-center md:text-center max-w-3xl">
            <p class="mt-6 text-lg text-base-content/80">
              I firmly believe that knowledge is for everyone. What's the point of achieving so much if I can't help someone else learn, grow, or become better? If my blog can help you, even 1%, that already makes me happy ^^
            </p>

            <p class="mt-6 text-lg text-base-content/80">
              Btw, there are four amazing people who have helped me a lot on this journey, including
              <a
                href="https://dad0qbu.github.io"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                Duy
              </a>,
              <a
                href="https://www.feyrer.de"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                Hubertf
              </a>,
              <a
                href="https://clowncs.github.io"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                Peter
              </a>, and
              <a
                href="https://github.com/ItzDavi"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                AgentPerry
              </a>. These guys are Chads in their own
              fields, and I'm grateful that I get to know and learn from them.
              Love you guys ❤️
            </p>
          </div>
        </div>
      </section>
      
    </div>
  </MainCard>
</BaseLayout>