---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
---

<BaseLayout title="About">
  <MainCard
    title="About"
    description="Cherish life, Enjoy every moments <3"
    image="/home.webp"
    alt="about image"
    infoIcon="lucide:user"
  >
    <div class="mb-6 space-y-6">

      <!-- Profile Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h1
            class="mb-4 text-4xl font-bold from-primary to-secondary hover:text-primary transition-colors duration-300 cursor-default"
          >
            Hwangstice
          </h1>

          <p class="mb-4 text-xl text-base-content/80">
            We Only Live Once
          </p>

          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://github.com/hwangstice"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:github" class="h-4 w-4" />
              <span>GitHub</span>
            </a>

            <a
              href="mailto:hwangstice@gmail.com"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:mail" class="h-4 w-4" />
              <span>Email</span>
            </a>
          </div>

          <div class="flex-1 text-center md:text-center max-w-3xl">
            <p class="mt-6 text-lg text-base-content/80">
              I firmly believe that knowledge is for everyone. What's the point of achieving so much if I can't help someone else learn, grow, or become better? If my blog can help you, even 1%, that already makes me happy ^^
            </p>

            <p class="mt-6 text-lg text-base-content/80">
              Btw, there are four amazing people who have helped me a lot on this journey, including
              <a
                href="https://dad0qbu.github.io"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                Duy
              </a>,
              <a
                href="https://www.feyrer.de"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                Hubertf
              </a>,
              <a
                href="https://clowncs.github.io"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                Peter
              </a>, and
              <a
                href="https://github.com/ItzDavi"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:underline"
              >
                AgentPerry
              </a>. These guys are Chads in their own
              fields, and I'm grateful that I get to know and learn from them.
              Love you guys ❤️
            </p>
          </div>
        </div>
      </section>

      <!-- Solo Section -->
      <section>
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:binary" class="h-6 w-6 text-primary" />
          Solo
        </h2>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://reversing.ctfd.io"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              RE CTFd
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Finisher #9
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="http://reversing.kr/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              Reversing.Kr
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Finisher #54
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://overthewire.org/wargames/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              OverTheWire
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Bandit, Leviathan
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://exploit.education/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              Exploit Education
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Protostar
            </p>
          </div>
        </div>
      </section>

      <!-- Scholarships Section -->
      <section class="mt-10">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:footprints" class="h-6 w-6 text-primary" />
          Scholarships
        </h2>

        <div class="grid grid-cols-1 gap-4">
          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <p class="text-lg font-bold">
              Academic Encouragement Scholarship (Semester 2, 2024 – 2025)
            </p>

            <p class="mt-1 text-sm text-base-content/70">
              Thanks my pals for carrying me :3
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://sacombankcareer.com/content/STB_Tintuc_Hocbong2024/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              Sacombank Scholarship 2024
            </a>

            <p class="mt-1 text-sm text-base-content/70">
              One of 45 Scholarship Recipients Nationwide
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://vnuhcm.edu.vn/en/article/92-scholarships-worth-over-vnd-3-billion-awarded-to-vnuhcm-students"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              CNCF Scholarship 2024
            </a>

            <p class="mt-1 text-sm text-base-content/70">
              One of 30 Scholarship Recipients at VNU-HCM
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <p class="text-lg font-bold">
              Academic Encouragement Scholarship (Semester 1, 2023 – 2024)
            </p>

            <p class="mt-1 text-sm text-base-content/70">
              Among the Top 3 Students with the Highest GPA in the Major
            </p>
          </div>
        </div>
      </section>

      <!-- Education Section -->
      <section class="mt-10">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:graduation-cap" class="h-6 w-6 text-primary" />
          Education
        </h2>

        <div
          class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
        >
          <a
            href="https://www.uit.edu.vn/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-bold hover:underline"
          >
            VNUHCM – University of Information Technology
          </a>

          <p class="mt-1 text-sm text-base-content/70">
            Bachelor of Information Security (Sep. 2023 – Present)
          </p>
        </div>
      </section>

      <!-- Experience Section -->
      <section class="mt-10">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:flame" class="h-6 w-6 text-primary" />
          Experience
        </h2>

        <div
          class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
        >
          <a
            href="https://sec.vnpt.vn"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-bold hover:underline"
          >
            VCI - VNPT Cyber Immunity
          </a>

          <p class="mt-1 text-sm text-base-content/70">
            Malware Analyst Intern (Jun. 2026 – Sep. 2026)
          </p>
        </div>
      </section>

    </div>
  </MainCard>
</BaseLayout>