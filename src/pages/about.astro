---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
---

<BaseLayout title="About">
  <MainCard
    title="About"
    description="Lives To Impact"
    image="/home.webp"
    alt="about image"
    infoIcon="lucide:user"
  >
    <div class="mb-6 space-y-6">

      <!-- Profile Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <h1
            class="mb-4 text-4xl font-bold from-primary to-secondary hover:text-primary transition-colors duration-300 cursor-default"
          >
            Hwangstice
          </h1>

          <p class="mb-4 text-xl text-base-content/80">
            Regulus Arne
          </p>

          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://github.com/hwangstice"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:github" class="h-4 w-4" />
              <span>GitHub</span>
            </a>

            <a
              href="mailto:hwangstice@gmail.com"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:mail" class="h-4 w-4" />
              <span>Email</span>
            </a>
          </div>

          <p class="mt-6 text-lg text-base-content/80">
            (wannabe) Reverse Engineer. Addicted to running.
            <br />
            <br />
            CTFs with
            <a
              href="https://ctftime.org/team/373205"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              $cr1pt_K1dd13$
            </a>.
          </p>
        </div>
      </section>

      <!-- Solo Section -->
      <section>
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:binary" class="h-6 w-6 text-primary" />
          Solo
        </h2>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://reversing.ctfd.io"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              RE CTFd
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Finisher #9
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="http://reversing.kr/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              Reversing.Kr
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Finisher #54
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://overthewire.org/wargames/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              OverTheWire
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Bandit, Leviathan
            </p>
          </div>

          <div
            class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
          >
            <a
              href="https://exploit.education/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-bold hover:underline"
            >
              Exploit Education
            </a>
            <p class="mt-1 text-sm text-base-content/70">
              Protostar
            </p>
          </div>
        </div>
      </section>

      <!-- Education Section -->
      <section class="mt-10">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:graduation-cap" class="h-6 w-6 text-primary" />
          Education
        </h2>

        <div
          class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
        >
          <a
            href="https://www.uit.edu.vn/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-bold hover:underline"
          >
            VNUHCM – University of Information Technology
          </a>

          <p class="mt-1 text-sm text-base-content/70">
            Bachelor of Information Security (Sep. 2023 – Present)
          </p>
        </div>
      </section>

      <!-- Experience Section -->
      <section class="mt-10">
        <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold">
          <Icon name="lucide:flame" class="h-6 w-6 text-primary" />
          Experience
        </h2>

        <div
          class="rounded-xl border border-base-300 p-5 transition-all duration-300 hover:border-primary hover:shadow-lg"
        >
          <a
            href="https://sec.vnpt.vn"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-bold hover:underline"
          >
            VCI - VNPT Cyber Immunity
          </a>

          <p class="mt-1 text-sm text-base-content/70">
            Malware Analyst Intern (Jun. 2026 – Present)
          </p>
        </div>
      </section>

    </div>
  </MainCard>
</BaseLayout>